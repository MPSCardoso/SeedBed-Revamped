<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>SeedBed</AssemblyName>
    <RootNamespace>SeedBed</RootNamespace>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <TargetFramework>netstandard2.1</TargetFramework>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <ILRepackTargetsFile>$(RepoRoot)build/Package.targets</ILRepackTargetsFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="YamlDotNet" Version="16.0.0" />
    <PackageReference Include="ILRepack.Lib.MSBuild.Task" Version="2.0.46" PrivateAssets="all" />
    <ProjectReference Include="../build/Dependencies/PieceManager/PieceManager.csproj" />
    <ProjectReference Include="../build/Dependencies/ServerSync/ServerSync.csproj" />
    <ProjectReference Include="../build/Dependencies/LocalizationManager/LocalizationManager.csproj" />
    <EmbeddedResource Include="assets/seedbedbundle" LogicalName="SeedBed.assets.seedbedbundle" />
    <EmbeddedResource Include="translations/English.yml" LogicalName="SeedBed.translations.English.yml" />
  </ItemGroup>
  <Import Project="$(RepoRoot)build/GameReferences.props" />
  <Import Project="$(RepoRoot)build/ValidatePaths.targets" />
</Project>
